# ==========================================
# Konfigurasi MongoDB untuk Streamlit
# ==========================================
# 1. Untuk pengujian lokal:
#    Salin file ini menjadi ".streamlit/secrets.toml"
#    lalu isi 'connection_string' dengan URI MongoDB Atlas Anda.
#
# 2. Untuk Streamlit Community Cloud:
#    Buka Dashboard Aplikasi -> Settings -> Secrets
#    dan salin teks di bawah ini ke dalamnya.

[mongo]
# Ganti dengan connection string MongoDB Atlas Anda:
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
connection_string = "mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority"
database = "pln_tracker"
collection = "meter_records"
